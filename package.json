{
  "name": "python-theme",
  "displayName": "Esmerald",
  "version": "2.10.0",
  "license": "MIT",
  "publisher": "esthorace",
  "description": "It's a beautiful theme",
  "icon": "static/esmerald.png",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "go",
    "golang",
    "python",
    "javascript",
    "typescript",
    "react",
    "html",
    "esmerald",
    "esmeralda",
    "astro",
    "fastapi",
    "django",
    "node",
    "dark",
    "light",
    "theme",
    "tema",
    "color"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Esmerald",
        "uiTheme": "vs-dark",
        "path": "./themes/esmerald.json"
      },
      {
        "label": "Esmerald Light",
        "uiTheme": "vs",
        "path": "./themes/esmerald-light.json"
      }
    ]
  },
  "author": "Esteban H. Acevedo <esteban.horacio.acevedo@gmail.com> (https://www.linkedin.com/in/esteban-acevedo-aberastain/)",
  "repository": {
    "url": "git+https://github.com/esthorace/esmerald.git",
    "type": "git"
  },
  "dependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "validate": "node scripts/validate-colors.js",
    "check": "pnpm build && pnpm validate",
    "split": "node scripts/split-language-scopes.js",
    "group": "node scripts/group-token-scopes.js",
    "package": "pnpm vsce package --no-dependencies",
    "publish": "pnpm vsce publish --no-dependencies"
  },
  "packageManager": "pnpm@12.4.2"
}
